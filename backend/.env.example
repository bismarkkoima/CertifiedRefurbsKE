# Copy to backend/.env and adjust.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://refurbs:refurbs@localhost:5432/certifiedrefurbs
SEED_ON_STARTUP=true

SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@certifiedrefurbs.co.ke
ADMIN_PASSWORD=admin12345

CORS_ORIGINS=http://localhost:3000

# simulate | sandbox | production
MPESA_ENV=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.co.ke/api/v1/payments/mpesa/callback

USD_TO_KES=129
